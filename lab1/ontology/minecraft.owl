    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://github.com/TheGeniusOfEternity/ai-systems/lab1/ontology/minecraft#contains -->

    <owl:ObjectProperty rdf:about="https://github.com/TheGeniusOfEternity/ai-systems/lab1/ontology/minecraft#contains">
        <rdfs:domain rdf:resource="https://github.com/TheGeniusOfEternity/ai-systems/lab1/ontology/minecraft#Structure"/>
        <rdfs:range rdf:resource="https://github.com/TheGeniusOfEternity/ai-systems/lab1/ontology/minecraft#Item"/>
    </owl:ObjectProperty>
    


    <!-- https://github.com/TheGeniusOfEternity/ai-systems/lab1/ontology/minecraft#drops -->

    <owl:ObjectProperty rdf:about="https://github.com/TheGeniusOfEternity/ai-systems/lab1/ontology/minecraft#drops">
        <rdfs:domain rdf:resource="https://github.com/TheGeniusOfEternity/ai-systems/lab1/ontology/minecraft#Mob"/>
        <rdfs:range rdf:resource="https://github.com/TheGeniusOfEternity/ai-systems/lab1/ontology/minecraft#Item"/>
    </owl:ObjectProperty>
    


    <!-- https://github.com/TheGeniusOfEternity/ai-systems/lab1/ontology/minecraft#generatesIn -->

    <owl:ObjectProperty rdf:about="https://github.com/TheGeniusOfEternity/ai-systems/lab1/ontology/minecraft#generatesIn">
